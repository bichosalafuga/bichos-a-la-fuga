<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Bichos a la fuga - Apostar</title>
<style>
body { font-family:sans-serif; margin:20px; }
fieldset { margin-bottom:20px; padding:10px; }
pre { background:#f0f0f0; padding:10px; white-space:pre-wrap; }
</style>
</head>
<body>
<header>
<h1>🐌 Apostar en Bichos a la fuga</h1>
</header>

<main>
<fieldset>
  <legend>Apostar</legend>
  <form id="apuestaForm">
    <label>Usuario:
      <select name="usuario" required>
        <option value="Toreto">Toreto</option>
        <option value="Sinhuellas">Sinhuellas</option>
        <option value="Gari">Gari</option>
      </select>
    </label>

    <label>Carrera:
      <select name="carrera" required>
        <option value="1">Escalada Pegada</option>
        <option value="2">Desliz Extremo</option>
        <option value="3">Reto Baboso</option>
        <option value="4">Turbo Caracol</option>
        <option value="5">Lenta Conquista</option>
        <option value="6">Súper Resbalón</option>
        <option value="7">Meta Babosa</option>
        <option value="8">Final Legendaria</option>
      </select>
    </label>

    <label>Tipo de apuesta:
      <select name="tipo" id="tipoApuesta" required>
        <option value="posicion">Posición final</option>
        <option value="primer_movimiento">Primer en moverse</option>
        <option value="primer_salida">Primer en salirse</option>
        <option value="tiempo">Tiempo de llegada</option>
        <option value="cuantos_llegan">Cuántos llegan</option>
      </select>
    </label>

    <div id="objetivoContainer"></div>

    <label>Cantidad de babosas: <input type="number" name="cantidad" min="1" required></label>
    <button type="submit">Apostar</button>
  </form>
  <pre id="apuestaResult"></pre>
</fieldset>

<script>
const participantes = ["Toreto","Sinhuellas","Tro Gari","Arrastrado","Baboso Flash"];
let apuestas = [];

const objetivoContainer=document.getElementById("objetivoContainer");
const tipoApuesta=document.getElementById("tipoApuesta");

function actualizarObjetivoInput(){
  const tipo=tipoApuesta.value;
  objetivoContainer.innerHTML="";
  if(tipo==="posicion"){
    const label=document.createElement("label"); label.textContent="Selecciona caracol y posición:";
    const selectCaracol=document.createElement("select"); selectCaracol.name="caracol";
    participantes.forEach(p=>{ const opt=document.createElement("option"); opt.value=p; opt.textContent=p; selectCaracol.appendChild(opt); });
    const selectPos=document.createElement("select"); selectPos.name="posicion";
    [1,2,3,4,5].forEach(n=>{ const opt=document.createElement("option"); opt.value=n; opt.textContent=n; selectPos.appendChild(opt); });
    label.appendChild(selectCaracol); label.appendChild(selectPos); objetivoContainer.appendChild(label);
  } else if(tipo==="primer_movimiento"||tipo==="primer_salida"){
    const label=document.createElement("label"); label.textContent="Selecciona caracol:";
    const select=document.createElement("select"); select.name="caracol";
    participantes.forEach(p=>{ const opt=document.createElement("option"); opt.value=p; opt.textContent=p; select.appendChild(opt); });
    label.appendChild(select); objetivoContainer.appendChild(label);
  } else if(tipo==="tiempo"){
    const label=document.createElement("label"); label.textContent="Selecciona rango de tiempo:";
    const select=document.createElement("select"); select.name="tiempo";
    ["0-10","10-20","20-30"].forEach(r=>{ const opt=document.createElement("option"); opt.value=r; opt.textContent=r; select.appendChild(opt); });
    label.appendChild(select); objetivoContainer.appendChild(label);
  } else if(tipo==="cuantos_llegan"){
    const label=document.createElement("label"); label.textContent="Selecciona cuántos llegan:";
    const select=document.createElement("select"); select.name="cantidadLlegan";
    [1,2,3,4,5].forEach(n=>{ const opt=document.createElement("option"); opt.value=n; opt.textContent=n; select.appendChild(opt); });
    label.appendChild(select); objetivoContainer.appendChild(label);
  }
}
actualizarObjetivoInput();
tipoApuesta.addEventListener("change", actualizarObjetivoInput);

document.getElementById("apuestaForm").addEventListener("submit",(e)=>{
  e.preventDefault();
  const form=e.target;
  let objetivo=null;
  const tipo=form.tipo.value;
  if(tipo==="posicion") objetivo={nombre:form.caracol.value,posicion:parseInt(form.posicion.value)};
  else if(tipo==="primer_movimiento"||tipo==="primer_salida") objetivo=form.caracol.value;
  else if(tipo==="tiempo") objetivo=form.tiempo.value;
  else if(tipo==="cuantos_llegan") objetivo=parseInt(form.cantidadLlegan.value);

  apuestas.push({usuario:form.usuario.value,carrera:form.carrera.value,tipo,objetivo,cantidad:parseInt(form.cantidad.value)});
  document.getElementById("apuestaResult").innerText=JSON.stringify(apuestas,null,2);
});
</script>
</body>
</html>
